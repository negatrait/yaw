@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix yaw:        <http://yaw.local/> .
@prefix concepts:   <http://yaw.local/concepts/> .
@prefix entities:   <http://yaw.local/entities/> .
@prefix predicates: <http://yaw.local/predicates/> .
@prefix claims:     <http://yaw.local/claims/> .
@prefix invariants: <http://yaw.local/invariants/> .
@prefix decisions:  <http://yaw.local/decisions/> .
@prefix processes:  <http://yaw.local/processes/> .
@prefix sources:    <http://yaw.local/sources/> .
@prefix contexts:   <http://yaw.local/contexts/> .
@prefix shapes:     <http://yaw.local/shapes/> .

# ----------------------------------------------------------------------
# 1. ConceptShape (yaw:ConceptShape & shapes:ConceptShape)
# Non-empty definition, <= 50 words, canonical URI syntax
# ----------------------------------------------------------------------

yaw:ConceptShape a sh:NodeShape ;
    sh:targetClass concepts:Root ;
    sh:targetSubjectsOf rdf:type, rdfs:label ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Concept definition must be non-empty and not exceed 50 words."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX concepts: <http://yaw.local/concepts/>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this (<http://www.w3.org/2004/02/skos/core#definition> AS ?path) (?def AS ?value)
            WHERE {
                $this rdf:type concepts:Root .
                OPTIONAL { $this skos:definition ?def }
                FILTER (!BOUND(?def) || !REGEX(STR(?def), "^\\\\s*\\\\S+(\\\\s+\\\\S+){0,49}\\\\s*$"))
            }
        ''' ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Node URI does not conform to the canonical 9-namespace pattern."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            SELECT $this (?this AS ?value)
            WHERE {
                FILTER (isIRI($this) && !STRSTARTS(STR($this), "http://www.w3.org/") && $this != <http://yaw.local/VaultScheme> && $this != <http://yaw.local/closeMatch>)
                FILTER (!REGEX(STR($this), "^http://yaw\\\\.local/((sources|contexts)/.+|(concepts|entities|predicates|claims|invariants|decisions|processes)/[A-Za-z0-9_.:-]+)$"))
            }
        ''' ;
    ] .

shapes:ConceptShape a sh:NodeShape ;
    owl:equivalentClass yaw:ConceptShape .

# ----------------------------------------------------------------------
# 2. RelationShape (yaw:RelationShape & shapes:RelationShape)
# Referential integrity, dangling pointers, unregistered namespaces
# ----------------------------------------------------------------------

yaw:RelationShape a sh:NodeShape ;
    sh:targetClass owl:Thing ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select '''
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX yaw: <http://yaw.local/>
            SELECT DISTINCT ?this
            WHERE {
                ?this ?p ?o .
                FILTER (!STRSTARTS(STR(?this), "http://www.w3.org/") && ?this != <http://yaw.local/closeMatch>)
                FILTER (?p != rdf:type && ?p != rdfs:label && ?p != skos:prefLabel &&
                        ?p != skos:definition && ?p != skos:inScheme && ?p != yaw:aliasStatus &&
                        ?p != yaw:contestedMerge && ?p != yaw:canonicalTarget && ?p != rdfs:subPropertyOf &&
                        !STRSTARTS(STR(?p), "http://www.w3.org/2002/07/owl#"))
            }
        ''' ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Relation target is dangling or does not exist in knowledge graph."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX yaw: <http://yaw.local/>
            SELECT $this (?p AS ?path) (?o AS ?value)
            WHERE {
                $this ?p ?o .
                FILTER (!STRSTARTS(STR($this), "http://www.w3.org/") && $this != <http://yaw.local/closeMatch>)
                FILTER (?p != rdf:type && ?p != rdfs:label && ?p != skos:prefLabel &&
                        ?p != skos:definition && ?p != skos:inScheme && ?p != yaw:aliasStatus &&
                        ?p != yaw:contestedMerge && ?p != yaw:canonicalTarget && ?p != rdfs:subPropertyOf &&
                        !STRSTARTS(STR(?p), "http://www.w3.org/2002/07/owl#"))
                FILTER (isIRI(?o) && !STRSTARTS(STR(?o), "http://www.w3.org/") && ?o != <http://yaw.local/closeMatch>)
                FILTER NOT EXISTS { ?o rdf:type ?anyType }
            }
        ''' ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Relation target has unregistered or invalid namespace."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX yaw: <http://yaw.local/>
            SELECT $this (?p AS ?path) (?o AS ?value)
            WHERE {
                $this ?p ?o .
                FILTER (!STRSTARTS(STR($this), "http://www.w3.org/") && $this != <http://yaw.local/closeMatch>)
                FILTER (?p != rdf:type && ?p != rdfs:label && ?p != skos:prefLabel &&
                        ?p != skos:definition && ?p != skos:inScheme && ?p != yaw:aliasStatus &&
                        ?p != yaw:contestedMerge && ?p != yaw:canonicalTarget && ?p != rdfs:subPropertyOf &&
                        !STRSTARTS(STR(?p), "http://www.w3.org/2002/07/owl#"))
                FILTER (isIRI(?o) && !STRSTARTS(STR(?o), "http://www.w3.org/") && ?o != <http://yaw.local/closeMatch>)
                FILTER (!REGEX(STR(?o), "^http://yaw\\\\.local/(concepts|entities|predicates|claims|invariants|decisions|processes|sources|contexts)/"))
            }
        ''' ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Relation subject has unregistered or invalid namespace."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX yaw: <http://yaw.local/>
            SELECT $this (?p AS ?path) ($this AS ?value)
            WHERE {
                $this ?p ?o .
                FILTER (!STRSTARTS(STR($this), "http://www.w3.org/") && $this != <http://yaw.local/closeMatch>)
                FILTER (?p != rdf:type && ?p != rdfs:label && ?p != skos:prefLabel &&
                        ?p != skos:definition && ?p != skos:inScheme && ?p != yaw:aliasStatus &&
                        ?p != yaw:contestedMerge && ?p != yaw:canonicalTarget && ?p != rdfs:subPropertyOf &&
                        !STRSTARTS(STR(?p), "http://www.w3.org/2002/07/owl#"))
                FILTER (isIRI($this))
                FILTER (!REGEX(STR($this), "^http://yaw\\\\.local/(concepts|entities|predicates|claims|invariants|decisions|processes|sources|contexts)/"))
            }
        ''' ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Relation predicate has unregistered or invalid namespace."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX yaw: <http://yaw.local/>
            SELECT $this (?p AS ?path) (?p AS ?value)
            WHERE {
                $this ?p ?o .
                FILTER (!STRSTARTS(STR($this), "http://www.w3.org/") && $this != <http://yaw.local/closeMatch>)
                FILTER (?p != rdf:type && ?p != rdfs:label && ?p != skos:prefLabel &&
                        ?p != skos:definition && ?p != skos:inScheme && ?p != yaw:aliasStatus &&
                        ?p != yaw:contestedMerge && ?p != yaw:canonicalTarget && ?p != yaw:closeMatch &&
                        ?p != rdfs:subPropertyOf &&
                        !STRSTARTS(STR(?p), "http://www.w3.org/2002/07/owl#"))
                FILTER (isIRI(?p))
                FILTER (!REGEX(STR(?p), "^(http://yaw\\\\.local/(predicates|concepts|entities|claims|invariants|decisions|processes|sources|contexts)/|http://www\\\\.w3\\\\.org/)"))
            }
        ''' ;
    ] .

shapes:RelationShape a sh:NodeShape ;
    owl:equivalentClass yaw:RelationShape .

# ----------------------------------------------------------------------
# 3. DialecticalIntegrityShape (yaw:DialecticalIntegrityShape & shapes:DialecticalIntegrityShape)
# Contradictory claims & contested alias merges
# ----------------------------------------------------------------------

yaw:DialecticalIntegrityShape a sh:NodeShape ;
    sh:targetClass owl:Thing ;
    sh:targetSubjectsOf predicates:causes, predicates:prevents, predicates:supports, predicates:contradicts, predicates:refutes ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Dialectical contradiction: Node simultaneously causes and prevents target."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX predicates: <http://yaw.local/predicates/>
            SELECT $this ?path (?target AS ?value)
            WHERE {
                $this predicates:causes ?target .
                $this predicates:prevents ?target .
                { BIND(<http://yaw.local/predicates/causes> AS ?path) }
                UNION
                { BIND(<http://yaw.local/predicates/prevents> AS ?path) }
            }
        ''' ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Dialectical contradiction: Node simultaneously supports and contradicts target."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX predicates: <http://yaw.local/predicates/>
            SELECT $this ?path (?target AS ?value)
            WHERE {
                {
                    $this predicates:supports ?target .
                    $this predicates:contradicts ?target .
                    { BIND(<http://yaw.local/predicates/supports> AS ?path) }
                    UNION
                    { BIND(<http://yaw.local/predicates/contradicts> AS ?path) }
                }
                UNION
                {
                    $this predicates:supports ?target .
                    ?target predicates:contradicts $this .
                    { BIND(<http://yaw.local/predicates/supports> AS ?path) }
                    UNION
                    { BIND(<http://yaw.local/predicates/contradicts> AS ?path) }
                }
            }
        ''' ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Dialectical contradiction: Node simultaneously supports and refutes target."@en ;
        sh:severity sh:Violation ;
        sh:select '''
            PREFIX predicates: <http://yaw.local/predicates/>
            SELECT $this ?path (?target AS ?value)
            WHERE {
                {
                    $this predicates:supports ?target .
                    $this predicates:refutes ?target .
                    { BIND(<http://yaw.local/predicates/supports> AS ?path) }
                    UNION
                    { BIND(<http://yaw.local/predicates/refutes> AS ?path) }
                }
                UNION
                {
                    $this predicates:supports ?target .
                    ?target predicates:refutes $this .
                    { BIND(<http://yaw.local/predicates/supports> AS ?path) }
                    UNION
                    { BIND(<http://yaw.local/predicates/refutes> AS ?path) }
                }
            }
        ''' ;
    ] .

shapes:DialecticalIntegrityShape a sh:NodeShape ;
    owl:equivalentClass yaw:DialecticalIntegrityShape .

# ----------------------------------------------------------------------
# 4. AmbiguousIdentityShape (yaw:AmbiguousIdentityShape & shapes:AmbiguousIdentityShape)
# >= 2 unlinked close matches warning
# ----------------------------------------------------------------------

yaw:AmbiguousIdentityShape a sh:NodeShape ;
    sh:targetClass owl:Thing ;
    sh:targetSubjectsOf yaw:closeMatch, skos:closeMatch ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ambiguous identity detected: node has multiple unlinked close matches."@en ;
        sh:severity sh:Warning ;
        sh:select '''
            PREFIX yaw: <http://yaw.local/>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT DISTINCT $this ?path (?target1 AS ?value)
            WHERE {
                {
                    $this yaw:closeMatch ?target1 .
                    BIND(yaw:closeMatch AS ?path)
                }
                UNION
                {
                    $this skos:closeMatch ?target1 .
                    BIND(skos:closeMatch AS ?path)
                }
                {
                    $this yaw:closeMatch ?target2 .
                }
                UNION
                {
                    $this skos:closeMatch ?target2 .
                }
                FILTER (?target1 != ?target2)
                FILTER NOT EXISTS {
                    ?target1 yaw:closeMatch ?target2 .
                }
                FILTER NOT EXISTS {
                    ?target1 skos:closeMatch ?target2 .
                }
                FILTER NOT EXISTS {
                    ?target2 yaw:closeMatch ?target1 .
                }
                FILTER NOT EXISTS {
                    ?target2 skos:closeMatch ?target1 .
                }
            }
        ''' ;
    ] .

shapes:AmbiguousIdentityShape a sh:NodeShape ;
    owl:equivalentClass yaw:AmbiguousIdentityShape .
